{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "flux": {
    "fileMatch": ["clusters/.+\\.yaml$"]
  },
  "kubernetes": {
    "fileMatch": ["clusters/.+\\.yaml$"]
  },
  "packageRules": [
    {
      "matchManagers": ["flux", "helm-values", "kubernetes"],
      "automerge": false
    },
    {
      "matchDepNames": ["postgres", "ghcr.io/cloudnative-pg/postgresql"],
      "matchUpdateTypes": ["major"],
      "enabled": false,
      "description": "Skip Postgres major bumps — they require data migration, not a tag bump."
    },
    {
      "matchDepNames": ["nvcr.io/nvidia/vllm"],
      "allowedVersions": "<=26.04-py3",
      "description": "Pin nvcr.io/nvidia/vllm — 26.06 segfaults in cuStreamCreateWithPriority on GB10 with driver 595."
    }
  ]
}
